FROM node:20-alpine

# No build toolchain here, and that is a change worth noting: the backend used to
# depend on `better-sqlite3`, a native addon with no prebuilt musl binary, so the
# image had to install python3/make/g++ and compile it at build time. That is the
# same dependency that made the Vercel build fail outright on a Node version it had
# no binary for. The store is Postgres now, reached over `pg`, which is pure
# JavaScript — nothing to compile, and nothing that can break when the platform
# changes its runtime.

WORKDIR /app

COPY backend/package*.json ./
RUN npm ci

COPY backend/ .
RUN npm run build

# The image no longer needs a writable data directory: the database is a separate
# service, not a file on a volume.
RUN chown -R node:node /app
USER node

ENV NODE_ENV=production
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/api/health || exit 1

CMD ["node", "dist/index.js"]
