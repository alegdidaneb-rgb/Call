# ---------------------------------------------------------------------------
# Frontend (Vite) — these are inlined into the browser bundle at build time.
# Anything prefixed VITE_ is PUBLIC. Never put a service_role or secret key here.
# ---------------------------------------------------------------------------

# Supabase (required for a hosted deployment, e.g. Vercel)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Self-hosted Express backend (optional).
# Set this to switch the frontend from Supabase mode to API mode.
# Leave EMPTY when deploying the static frontend against Supabase.
VITE_API_URL=

# SIP credentials for the browser softphone.
# NOTE: these are shipped to the browser, so treat them as per-agent,
# low-trust credentials and rotate them if they leak.
VITE_SIP_URI=sip:your-extension@your-domain.sip.signalwire.com
VITE_SIP_PASSWORD=your-sip-password
VITE_SIP_WS_URL=wss://your-domain.sip.signalwire.com
VITE_SIP_CALLER_ID=+1XXXXXXXXXX
# One of: signalwire, telnyx, twilio, bitcall, custom.
# Anything else is treated as `custom`, which is why the allowed values are named
# here rather than left to be guessed.
VITE_SIP_PROVIDER=custom

# TURN relay. Optional, and the only thing that carries media when both ends are
# behind a symmetric NAT or a firewall dropping inbound UDP — where STUN produces a
# call that connects in silence. All three are needed together: a relay given no
# credential refuses the allocation and the browser falls back to a direct path.
# Separate multiple servers with commas or whitespace.
# Stored in plaintext because the browser has to send it; use a credential that can
# only allocate relays. See SECURITY.md and docs/sip-providers.md.
VITE_SIP_TURN_URLS=turn:turn.example.com:3478?transport=tcp
VITE_SIP_TURN_USERNAME=cold-dialer
VITE_SIP_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Backend (Express + Postgres) — server-side only, never exposed to the browser.
# See backend/.env.example for the full list.
# ---------------------------------------------------------------------------
