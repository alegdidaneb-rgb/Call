# ---------------------------------------------------------------------------
# Frontend (Vite) — these are inlined into the browser bundle at build time.
# Anything prefixed VITE_ is PUBLIC. Never put a service_role or secret key here.
# ---------------------------------------------------------------------------

# Supabase (required for a hosted deployment, e.g. Vercel)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Self-hosted Express backend (optional).
# Set this to switch the frontend from Supabase mode to API mode.
# Leave EMPTY when deploying the static frontend against Supabase.
VITE_API_URL=

# SIP credentials for the browser softphone.
# NOTE: these are shipped to the browser, so treat them as per-agent,
# low-trust credentials and rotate them if they leak.
VITE_SIP_URI=sip:your-extension@your-domain.sip.signalwire.com
VITE_SIP_PASSWORD=your-sip-password
VITE_SIP_WS_URL=wss://your-domain.sip.signalwire.com
VITE_SIP_CALLER_ID=+1XXXXXXXXXX
VITE_SIP_PROVIDER=custom

# ---------------------------------------------------------------------------
# Backend (Express + SQLite) — server-side only, never exposed to the browser.
# See backend/.env.example for the full list.
# ---------------------------------------------------------------------------
