# ---------------------------------------------------------------------------
# Root environment template.
#
# The app runs in one of two modes, chosen by whether VITE_API_URL is set:
#
#   1. Supabase mode (recommended for hosting, e.g. Vercel)
#        VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY set, VITE_API_URL empty.
#        The static frontend talks to Supabase directly; RLS is the security
#        boundary. No Express server required.
#
#   2. Self-hosted API mode
#        VITE_API_URL set. The frontend calls the Express + Postgres backend,
#        which needs DATABASE_URL, JWT_SECRET and CORS_ORIGINS.
# ---------------------------------------------------------------------------

# --- Frontend (public, inlined into the bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# --- SIP softphone (public; use per-agent, rotatable credentials) ---
VITE_SIP_URI=sip:your-extension@your-domain.sip.signalwire.com
VITE_SIP_PASSWORD=your-sip-password
VITE_SIP_WS_URL=wss://your-domain.sip.signalwire.com
VITE_SIP_CALLER_ID=+1XXXXXXXXXX
# One of: signalwire, telnyx, twilio, bitcall, freeswitch, custom. Anything else
# is treated as `custom`. The value names the preset whose port and WebSocket path
# are used to derive VITE_SIP_WS_URL when that is left blank, so it decides where
# the browser connects: 7443 for freeswitch and telnyx, 8089/ws for custom
# (Asterisk). Providers that need a gateway you run -- signalwire, twilio, bitcall
# -- derive nothing and require an explicit VITE_SIP_WS_URL.
VITE_SIP_PROVIDER=custom

# --- Backend (server-side only, required in production) ---
# REQUIRED. Postgres connection string; there is no local-file fallback.
#   postgres://user:password@host:5432/dbname
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT=2mb
MAX_IMPORT_ROWS=1000
BCRYPT_ROUNDS=12
SEED_ADMIN_PASSWORD=
