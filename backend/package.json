{
  "name": "cold-dialer-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.lint.json && npm run check:async && npm run check:sql",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lint.json",
    "check:async": "tsx scripts/check-async-db.ts",
    "check:sql": "tsx scripts/check-sql-rewriter.ts && tsx scripts/check-sql-placeholders.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "uuid": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "body-parser": "^1.20.9",
    "qs": "^6.16.2"
  }
}
