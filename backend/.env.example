# ---------------------------------------------------------------------------
# Backend (Express + Postgres) — server-side only.
# Copy to .env (git-ignored) for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# REQUIRED in production. The server refuses to boot without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Token lifetime, e.g. 15m, 8h, 7d
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
# "*" allows any origin. Do not use "*" together with credentials in production.
CORS_ORIGINS=http://localhost:3000

# Request body limit for express.json()
BODY_LIMIT=2mb

# Maximum rows accepted by POST /api/leads/import in one request
MAX_IMPORT_ROWS=1000

# bcrypt cost factor (10-15; higher is slower and stronger)
BCRYPT_ROUNDS=12

# REQUIRED. Postgres connection string. The server refuses to boot without it:
# there is deliberately no default, because a silent fallback produces a working
# server full of empty tables instead of an error you can act on.
#   postgres://user:password@host:5432/dbname
DATABASE_URL=

# TLS to the database, using libpq's names:
#   require      (default) encrypted, certificate not verified — what managed
#                providers document, including Supabase
#   verify-full  encrypted and the certificate chain verified
#   disable      no TLS; only on a private network such as a compose bridge
# An unrecognised value is rejected at startup rather than silently defaulted.
# PGSSLMODE=require

# Connections held per instance. Serverless scales by instance, so a high number
# multiplies: 10 instances x 10 connections exhausts a small managed database's
# limit and starts refusing the application it is serving.
# PGPOOL_MAX=3

# Password for the seeded 'seedadmin' account.
# If unset, the seed script uses the well-known development password and warns.
SEED_ADMIN_PASSWORD=
