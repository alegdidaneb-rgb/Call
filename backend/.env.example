# ---------------------------------------------------------------------------
# Backend (Express + SQLite) — server-side only.
# Copy to .env (git-ignored) for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# REQUIRED in production. The server refuses to boot without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Token lifetime, e.g. 15m, 8h, 7d
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
# "*" allows any origin. Do not use "*" together with credentials in production.
CORS_ORIGINS=http://localhost:3000

# Request body limit for express.json()
BODY_LIMIT=2mb

# Maximum rows accepted by POST /api/leads/import in one request
MAX_IMPORT_ROWS=1000

# bcrypt cost factor (10-15; higher is slower and stronger)
BCRYPT_ROUNDS=12

# SQLite location. Defaults to <backend>/data/cold-dialer.db
# DATABASE_PATH=/var/lib/cold-dialer/cold-dialer.db
# DATA_DIR=/var/lib/cold-dialer

# Password for the seeded admin@example.com account.
# If unset, the seed script uses the well-known development password and warns.
SEED_ADMIN_PASSWORD=
